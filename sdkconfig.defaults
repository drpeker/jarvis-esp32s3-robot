# Jarvis v1.7: ESP32-S3 N16R8 (16 MB flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# PSRAM: big buffers (audio, JPEG, HTTP bodies) go there; internal RAM stays free for
# task stacks, DMA and Wi-Fi.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# TLS buffers in PSRAM (each HTTPS connection otherwise takes ~40 KB of internal RAM).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# OTA from the Mac over plain HTTP (same as the old Jarvis console 'ota').
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Panic: print and reboot; the crash recorder keeps the reason in RTC memory.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Camera: SCCB on the already created I2C bus (port 1), new i2c_master driver.
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_OV2640_SUPPORT=y
CONFIG_CAMERA_CORE0=y

# LVGL 9 (face): canvas, labels, images; Montserrat 14/20/48 like the old face.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_USE_CLIB_MALLOC=y

# Smaller, faster code than -Og
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Same as the bootloader on the robot: OTA images must confirm themselves (app_main).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# System event task: Wi-Fi/IP handlers log; 2.3 KB default is tight.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Captions: ready-made Noto Sans 14 bitmap font from flash (main/fonts); no run-time font
# rendering (tiny_ttf off).
# The font file uses LVGL's large glyph records (16 bytes), as in the earlier firmware.
CONFIG_LV_FONT_FMT_TXT_LARGE=y


# Wake word: Jarvis (WakeNet9) from the esp-sr component. main/CMakeLists.txt packs the
# selected models into srmodels.bin at build time and embeds it in the app: nothing is read
# from other flash partitions, so the firmware works on any ESP32-S3 N16R8.
CONFIG_SR_WN_WN9_JARVIS_TTS=y
